@model Scholar
@{
    ViewData["Title"] = "Delete scholar";
}

<h1>Delete scholar</h1>

<p>
    Delete <strong>@Model.FullName</strong> (@Model.Program, year @Model.YearLevel)?
    This cannot be undone.
</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="actions">
        <button type="submit">Delete</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
